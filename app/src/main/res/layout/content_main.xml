<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_header"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/surface_dark"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Visualizer Centered 50% -->
        <ch.schmidlins.mini_synth.ui.VisualizerView
            android:id="@+id/visualizer_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.5" />

        <!-- Metronome Right 25% -->
        <LinearLayout
            android:id="@+id/metronome_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/visualizer_view">

            <!-- Compact Row: MET Toggle, Indicator, BPM Label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_metronome_toggle"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.2"
                    android:padding="0dp"
                    android:text="MET"
                    android:textColor="@color/acid_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/beat_indicator"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/tv_bpm_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="120"
                    android:textColor="@color/acid_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- High Contrast Adjustment Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btn_bpm_down"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="-5"
                    android:textColor="@color/acid_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_bpm_down_fine"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="-1"
                    android:textColor="@color/acid_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_bpm_up_fine"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="+1"
                    android:textColor="@color/acid_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_bpm_up"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="+5"
                    android:textColor="@color/acid_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Left 25% for symmetry/future features -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/visualizer_view" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/keyboard_pad_view"
        app:layout_constraintTop_toBottomOf="@id/top_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/control_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <Button
                    android:id="@+id/btn_mode_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pads" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btn_poly_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Poly: ON" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oct:"
                    android:textColor="@color/off_white" />

                <Button
                    android:id="@+id/btn_octave_down"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="-" />

                <TextView
                    android:id="@+id/tv_octave_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:text="0"
                    android:textColor="@color/off_white" />

                <Button
                    android:id="@+id/btn_octave_up"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="+" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/preset_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <Button
                    android:id="@+id/btn_save_preset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btn_load_preset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Load" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/btn_mock_rec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:text="REC"
                    android:textColor="@color/vibrant_red" />

                <Button
                    android:id="@+id/btn_mock_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:text="PLAY"
                    android:textColor="@color/electric_blue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/waveform_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wav:"
                    android:textColor="@color/off_white"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_waveform"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:checkedButton="@id/btn_wave_sine"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/btn_wave_sine"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:padding="0dp"
                        android:text="SINE"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btn_wave_square"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:padding="0dp"
                        android:text="SQR"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btn_wave_saw"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:padding="0dp"
                        android:text="SAW"
                        android:textSize="9sp" />

                    <Button
                        android:id="@+id/btn_wave_triangle"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="48dp"
                        android:layout_height="40dp"
                        android:padding="0dp"
                        android:text="TRI"
                        android:textSize="9sp" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <Space
                    android:layout_width="16dp"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tv_master_vol_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="30dp"
                    android:text="80%"
                    android:textColor="@color/dim_grey"
                    android:textSize="10sp" />

                <SeekBar
                    android:id="@+id/seek_master_vol"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="80" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/adsr_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textColor="@color/off_white" />

                <SeekBar
                    android:id="@+id/seek_attack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="10" />

                <TextView
                    android:id="@+id/tv_attack_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="40dp"
                    android:text="0.1"
                    android:textColor="@color/dim_grey"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D"
                    android:textColor="@color/off_white" />

                <SeekBar
                    android:id="@+id/seek_decay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="10" />

                <TextView
                    android:id="@+id/tv_decay_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="40dp"
                    android:text="0.1"
                    android:textColor="@color/dim_grey"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textColor="@color/off_white" />

                <SeekBar
                    android:id="@+id/seek_sustain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="80" />

                <TextView
                    android:id="@+id/tv_sustain_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="40dp"
                    android:text="0.8"
                    android:textColor="@color/dim_grey"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R"
                    android:textColor="@color/off_white" />

                <SeekBar
                    android:id="@+id/seek_release"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="10" />

                <TextView
                    android:id="@+id/tv_release_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="40dp"
                    android:text="0.1"
                    android:textColor="@color/dim_grey"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/lfo_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LFO Rate"
                    android:textColor="@color/off_white"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_lfo_rate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="20" />

                <TextView
                    android:id="@+id/tv_lfo_rate_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="40dp"
                    android:text="1.0Hz"
                    android:textColor="@color/dim_grey"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Depth"
                    android:textColor="@color/off_white"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_lfo_depth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0" />

                <TextView
                    android:id="@+id/tv_lfo_depth_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="40dp"
                    android:text="0.0"
                    android:textColor="@color/dim_grey"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LFO Wave:"
                    android:textColor="@color/off_white"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinner_lfo_waveform"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="match_parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target:"
                    android:textColor="@color/off_white"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinner_lfo_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/filter_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cutoff"
                    android:textColor="@color/off_white"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_filter_cutoff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50" />

                <TextView
                    android:id="@+id/tv_filter_cutoff_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="60dp"
                    android:text="1000Hz"
                    android:textColor="@color/dim_grey"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Res"
                    android:textColor="@color/off_white"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_filter_res"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="20" />

                <TextView
                    android:id="@+id/tv_filter_res_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="40dp"
                    android:text="0.20"
                    android:textColor="@color/dim_grey"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ch.schmidlins.mini_synth.ui.KeyboardPadView
        android:id="@+id/keyboard_pad_view"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

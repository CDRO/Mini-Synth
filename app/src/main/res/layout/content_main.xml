<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:id="@+id/control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btn_mode_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pads" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wav:"
            android:textColor="@color/off_white"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_waveform"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedButton="@id/btn_wave_sine"
            app:singleSelection="true">

            <Button
                android:id="@+id/btn_wave_sine"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:padding="0dp"
                android:text="SINE"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btn_wave_square"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:padding="0dp"
                android:text="SQR"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btn_wave_saw"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:padding="0dp"
                android:text="SAW"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btn_wave_triangle"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:padding="0dp"
                android:text="TRI"
                android:textSize="9sp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btn_poly_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Poly: ON" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btn_save_preset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btn_load_preset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Load" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btn_mock_rec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:text="REC"
            android:textColor="@color/vibrant_red" />

        <Button
            android:id="@+id/btn_mock_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:text="PLAY"
            android:textColor="@color/electric_blue" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oct:"
            android:textColor="@color/off_white" />

        <Button
            android:id="@+id/btn_octave_down"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="-" />

        <TextView
            android:id="@+id/tv_octave_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="0"
            android:textColor="@color/off_white" />

        <Button
            android:id="@+id/btn_octave_up"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="+" />

        <Space
            android:layout_width="16dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tv_master_vol_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="30dp"
            android:text="80%"
            android:textColor="@color/dim_grey"
            android:textSize="10sp" />

        <SeekBar
            android:id="@+id/seek_master_vol"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="80" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/adsr_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/control_bar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A"
            android:textColor="@color/off_white" />

        <SeekBar
            android:id="@+id/seek_attack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="10" />

        <TextView
            android:id="@+id/tv_attack_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:text="0.1"
            android:textColor="@color/dim_grey"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D"
            android:textColor="@color/off_white" />

        <SeekBar
            android:id="@+id/seek_decay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="10" />

        <TextView
            android:id="@+id/tv_decay_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:text="0.1"
            android:textColor="@color/dim_grey"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S"
            android:textColor="@color/off_white" />

        <SeekBar
            android:id="@+id/seek_sustain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="80" />

        <TextView
            android:id="@+id/tv_sustain_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:text="0.8"
            android:textColor="@color/dim_grey"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R"
            android:textColor="@color/off_white" />

        <SeekBar
            android:id="@+id/seek_release"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="10" />

        <TextView
            android:id="@+id/tv_release_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:text="0.1"
            android:textColor="@color/dim_grey"
            android:textSize="10sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lfo_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/adsr_bar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LFO Rate"
            android:textColor="@color/off_white"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seek_lfo_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="20" />

        <TextView
            android:id="@+id/tv_lfo_rate_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:text="1.0Hz"
            android:textColor="@color/dim_grey"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Depth"
            android:textColor="@color/off_white"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seek_lfo_depth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_lfo_depth_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:text="0.0"
            android:textColor="@color/dim_grey"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wave:"
            android:textColor="@color/off_white"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinner_lfo_waveform"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target:"
            android:textColor="@color/off_white"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinner_lfo_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/lfo_bar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cutoff"
            android:textColor="@color/off_white"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seek_filter_cutoff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="50" />

        <TextView
            android:id="@+id/tv_filter_cutoff_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60dp"
            android:text="1000Hz"
            android:textColor="@color/dim_grey"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Res"
            android:textColor="@color/off_white"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seek_filter_res"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="20" />

        <TextView
            android:id="@+id/tv_filter_res_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:text="0.20"
            android:textColor="@color/dim_grey"
            android:textSize="10sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/metronome_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/filter_bar">

        <Button
            android:id="@+id/btn_metronome_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Metronome: OFF" />

        <View
            android:id="@+id/beat_indicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:background="@android:color/darker_gray" />

        <Space
            android:layout_width="16dp"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BPM:"
            android:textColor="@color/off_white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_bpm_down"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="-5"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_bpm_down_fine"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="-1"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_bpm_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:text="120"
            android:textColor="@color/off_white" />

        <Button
            android:id="@+id/btn_bpm_up_fine"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="+1"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_bpm_up"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="+5"
            android:textSize="10sp" />

    </LinearLayout>

    <ch.schmidlins.mini_synth.ui.VisualizerView
        android:id="@+id/visualizer_view"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintTop_toBottomOf="@id/metronome_bar" />

    <ch.schmidlins.mini_synth.ui.KeyboardPadView
        android:id="@+id/keyboard_pad_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/visualizer_view" />

</androidx.constraintlayout.widget.ConstraintLayout>

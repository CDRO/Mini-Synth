    <!-- Help Strings -->
    <string name="help_mode_toggle">Switch between a 13-key keyboard and a grid of customizable pads.</string>
    <string name="help_polyphony">Toggle Polyphony. ON allows playing multiple notes. OFF limits to one note (Monophonic).</string>
    <string name="help_record_session">Record your session directly to an MP3 file on your device.</string>
    <string name="help_mock_play">Toggle test playback state (Visual only in mock mode).</string>
    <string name="help_waveform_sine">Select the base oscillator waveform: Sine, Square, Saw, or Triangle.</string>
    <string name="help_octave_down">Shift the keyboard range down by one octave.</string>
    <string name="help_octave_up">Shift the keyboard range up by one octave.</string>
    <string name="help_master_volume">Adjust the overall output volume and master panning.</string>
    <string name="help_projects">Project Browser: Manage your music projects (Save, Load, Create). Spatial data is persisted.</string>
    <string name="help_zen_mode">Zen Mode hides the complex parameter controls to focus on the performance area.</string>
    <string name="help_browser_toggle">Toggle the Sample Browser to load factory or recorded sounds onto pads.</string>
    <string name="help_sample_item_format">Sample: %s. Click to enter mapping mode, then touch a pad to assign.</string>
    <string name="help_cols_down">Pad Grid: Decrease the number of columns (vertical dividers).</string>
    <string name="help_cols_up">Pad Grid: Increase the number of columns (vertical dividers).</string>
    <string name="help_rows_down">Pad Grid: Decrease the number of rows (horizontal dividers).</string>
    <string name="help_rows_up">Pad Grid: Increase the number of rows (horizontal dividers).</string>
    <string name="help_bank_prev">Switch to the previous bank of pads.</string>
    <string name="help_bank_next">Switch to the next bank of pads.</string>
    <string name="help_sequencer_play">Start or stop the MIDI sequencer loop playback.</string>
    <string name="help_sequencer_rec">Enable Real-time Recording. Capture your keyboard performance into the loop automatically.</string>
    <string name="help_pad_sampling">Enable Pad Sampling. Capture engine output directly onto a pad by touching it.</string>
    <string name="help_step_rec">Step Recording: Enter notes one-by-one. Each key press advances to the next step.</string>
    <string name="help_step_rest">Skip the current step without adding a note (Rest).</string>
    <string name="help_step_back">Go back to the previous step and clear it.</string>
    <string name="help_sequencer_clear">Clear all notes from the sequencer grid.</string>
    <string name="help_sequencer_export">Export sequence: Renders the current pattern to a high-quality WAV file for sharing.</string>
    <string name="help_step_toggle_format">Toggle note at step %d.</string>
    <string name="help_metronome">Toggle the Metronome. Heard as a click synced to the BPM.</string>
    <string name="help_save_preset">Save the current synthesizer parameters (OSC, ADSR, LFO, Filter) as a named preset.</string>
    <string name="help_load_preset">Load a previously saved synthesizer preset.</string>
    <string name="help_sequencer_options">Sequencer Options: Access SAVE, LOAD, EXP, and Quantize settings.</string>
    <string name="help_pad_config_toggle">Pad Edit Mode: When ON, touching a pad opens its configuration immediately. When OFF, you can sustain pad notes by holding them.</string>
    <string name="help_lfo_rate">LFO Rate: Speed of the oscillation (0.1Hz to 20Hz). Scale also affects LFO Depth.</string>
    <string name="help_lfo_depth">LFO Depth: Intensity of the modulation effect.</string>
    <string name="help_filter_cutoff">Cutoff: Frequency above which sounds are attenuated. Resonance adds a boost at the cutoff point.</string>
    <string name="help_filter_res">Resonance: Emphasizes frequencies near the cutoff point for a "squeaky" or "wet" sound.</string>

